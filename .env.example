# === GTM Copilot — Variables d'environnement ===
# Copie ce fichier en `.env` et remplis avec tes valeurs.
# Voir `docs/SETUP.md` pour le guide d'install complet.

# === LinkedIn (adapter Unipile) ===
# Récupère ces valeurs dans le Dashboard Unipile (Settings > API).
# Le DSN doit inclure le scheme https://.
UNIPILE_DSN=https://api17.unipile.com:14708
UNIPILE_API_KEY=
UNIPILE_LINKEDIN_ACCOUNT_ID=

# === Email + Calendrier (port _shared/email.md) ===
# Choisis ton provider mail : gmail-gog | ms365-mcp | unipile-outlook (legacy)
EMAIL_PROVIDER=gmail-gog
# - gmail-gog    : CLI `gog` (aucune var ici, gog gère son auth)
# - ms365-mcp    : serveur MCP @softeria/ms-365-mcp-server (aucune var ici, tool `login`)
# - unipile-outlook (legacy) : réutilise les creds Unipile ci-dessus + :
# UNIPILE_OUTLOOK_ACCOUNT_ID=

# === CRM ===
# Choisis ton CRM : airtable, notion, nocodb, ou custom
CRM_PROVIDER=airtable

# --- Airtable ---
# Voir .claude/skills/_shared/providers/crm/airtable.md
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE_ID=

# --- Notion ---
# Voir .claude/skills/_shared/providers/crm/notion.md
# NOTION_API_KEY=
# NOTION_DATABASE_ID=

# --- NocoDB ---
# Voir .claude/skills/_shared/providers/crm/nocodb.md
# NOCODB_URL=
# NOCODB_TOKEN=
# NOCODB_TABLE_ID=

# --- Custom ---
# Voir .claude/skills/_shared/providers/crm/custom.md
# CRM_CUSTOM_API_URL=
# CRM_CUSTOM_API_KEY=

# === Enrichissement (optionnel) ===
# FullEnrich pour récupérer mails/téléphones depuis LinkedIn
# FULLENRICH_API_KEY=
