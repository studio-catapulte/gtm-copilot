# === GTM Copilot — Variables d'environnement ===
# Copie ce fichier en `.env` et remplis avec tes valeurs.
# Voir `docs/SETUP.md` pour le guide d'install complet.

# === LinkedIn (adapter Unipile) ===
# Récupère ces valeurs dans le Dashboard Unipile (Settings > API).
# Le DSN doit inclure le scheme https://.
UNIPILE_DSN=https://api17.unipile.com:14708
UNIPILE_API_KEY=
UNIPILE_LINKEDIN_ACCOUNT_ID=

# === Email + Calendrier ===
# Le provider actif se déclare dans CLAUDE.md > Outils actifs (pas ici).
# Secrets selon l'adapter :
# - gmail-gog    : aucune var (gog gère son auth)
# - ms365-mcp    : aucune var (serveur MCP, tool `login`)
# - unipile-outlook (legacy) : creds Unipile ci-dessus + :
# UNIPILE_OUTLOOK_ACCOUNT_ID=

# === CRM ===
# Le CRM actif se déclare dans CLAUDE.md > Outils actifs (pas ici).
# Renseigne seulement les secrets de l'adapter choisi :

# --- Airtable ---
# Voir docs/crm/airtable.md
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE_ID=

# --- Notion ---
# Voir docs/crm/notion.md
# NOTION_API_KEY=
# NOTION_DATABASE_ID=

# --- NocoDB ---
# Voir docs/crm/nocodb.md
# NOCODB_URL=
# NOCODB_TOKEN=
# NOCODB_TABLE_ID=

# --- Custom ---
# Voir docs/crm/custom.md
# CRM_CUSTOM_API_URL=
# CRM_CUSTOM_API_KEY=

# === Enrichissement (optionnel) ===
# FullEnrich pour récupérer mails/téléphones depuis LinkedIn
# FULLENRICH_API_KEY=
